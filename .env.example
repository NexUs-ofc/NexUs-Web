# Copie para .env (nunca versione o .env real)
VITE_AUTH_API_BASE_URL=https://ceris-auth.vercel.app
VITE_CORE_API_BASE_URL=https://ceris-core.vercel.app
VITE_AUTH_API_KEY=default
# O core usa apenas cookies (credentials), sem X-API-KEY
# API de relatórios/dashboard (NexUs-BI-AI/report_generator). Exige X-API-Key + Bearer do NexUs-Auth.
# A chave é a API_KEY do .env do backend; VITE_* vai para o navegador, então use a chave de cliente, nunca a service role.
VITE_REPORTS_API_BASE_URL=http://localhost:8001
VITE_REPORTS_API_KEY=
