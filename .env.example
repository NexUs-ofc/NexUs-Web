# Copie para .env (nunca versione o .env real)
VITE_AUTH_API_BASE_URL=https://ceris-auth.discloud.app
VITE_CORE_API_BASE_URL=https://ceris-core.discloud.dev
VITE_VIACEP_API_BASE_URL=https://viacep.com.br
VITE_AUTH_API_KEY=default
# O core usa o Bearer token da sessão e cookies (credentials), sem X-API-KEY
# API NexUs-BI-AI (app/app.py): chatbot, rankings, dashboard e relatórios. Roda em uvicorn app.app:app (porta 8000).
# Exige X-API-Key + Bearer do NexUs-Auth; VITE_* vai para o navegador, então use a chave de cliente, nunca a service role.
# API_KEY do .env do backend (campo API_KEY). Jamais use a chave de produção em branches de dev.
VITE_CHATBOT_API_BASE_URL=http://localhost:8000
VITE_CHATBOT_API_KEY=
